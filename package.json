{
  "name": "whatsapp-msgstore-api",
  "version": "1.0.0",
  "description": "TypeScript API for WhatsApp msgstore.db database",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc -w",
    "clean": "rm -rf dist",
    "start:db": "npm run build && node dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.3",
    "@types/cors": "^2.8.17",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3"
  }
}
